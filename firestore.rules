rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: authenticated users can read; only the owner can write their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Posts: authenticated users can read, create, and update likes/attachments
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.authorId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'commentsCount', 'mediaUrl', 'storagePath']));

      // Likes subcollection: strictly 1 doc per user ID (= 1 like per user)
      match /likes/{likeUserId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == likeUserId;
        allow delete: if request.auth != null
          && request.auth.uid == likeUserId;
      }
    }

    // Doubts and replies
    match /doubts/{doubtId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid;
      }
    }
  }
}
